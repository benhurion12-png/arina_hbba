generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum RiskLevel {
  PLANNED
  URGENT
  EMERGENCY
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(CLIENT)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  analyses     Analysis[]
  auditLogs    AuditLog[]  @relation("AuditActor")

  @@index([role, status])
}

model Analysis {
  id             String    @id @default(uuid())
  userId         String
  zones          String[]
  symptoms       String    @db.Text
  redFlags       String[]
  attachmentText String?   @db.Text
  specialist     String
  urgency        String
  riskLevel      RiskLevel
  result         Json
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([riskLevel, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
